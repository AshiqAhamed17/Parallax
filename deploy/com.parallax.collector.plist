<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.parallax.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/target/release/collector</string>
        <string>--db-path</string>
        <string>__REPO_ROOT__/data/parallax.db</string>
        <string>--archive-dir</string>
        <string>__REPO_ROOT__/data/archive</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/data/collector.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/data/collector.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
</dict>
</plist>
