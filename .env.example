# Manifold's public read endpoints (GET /v0/markets, /v0/bets, etc.) need no key at all —
# confirmed live: `curl https://api.manifold.markets/v0/markets` returns data with no auth.
# Only set this if a future feature calls an authenticated Manifold endpoint (this project's
# scope never requires it — see implementation.md constraint #1: no real bets, ever).
MANIFOLD_API_KEY=

# Metaculus's actual API/auth requirements could NOT be verified from this environment — their
# site sits behind a Cloudflare bot-challenge that blocks even the plain homepage for automated
# tools. Verify manually (real browser, likely requires a Metaculus account) before Phase 7.
# See docs/metaculus-tos-check.md.
METACULUS_API_KEY=

DATABASE_PATH=./data/parallax.db
PARQUET_ARCHIVE_PATH=./data/archive
API_BASE_URL=http://localhost:8000
